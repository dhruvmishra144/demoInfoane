{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "demoinfoane",
	// Pinned so every wrangler command (deploy, d1, dev) targets this account
	// no matter which Cloudflare login is active on the machine.
	"account_id": "192221afb7b8561a9760a79748e6f27e",
	"main": ".open-next/worker.js",
	// nodejs_compat is mandatory for the OpenNext adapter; the date must be
	// 2024-09-23 or later for it to take effect.
	"compatibility_date": "2026-08-18",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},
	// Cloudflare Images binding: the OpenNext image handler behind /_next/image
	// uses it to resize and convert to AVIF/WebP. Without it every image request
	// logs "env.IMAGES binding is not defined" and the originals are served as-is.
	"images": {
		"binding": "IMAGES"
	},
	"observability": {
		"enabled": true
	},
	"d1_databases": [
		{
			// Site content, users, sessions and the audit log.
			"binding": "DB",
			"database_name": "infoane-content",
			"database_id": "c8b534ff-c795-4d21-a4bc-fe9a34524aec",
			"migrations_dir": "drizzle/migrations",
			// Required, not cosmetic: pages read content during `next build`
			// (generateStaticParams, sitemap.ts, every prerendered page). Without
			// this, the build emulates D1 locally against an empty database in the
			// build container, which fails with `no such table: content_items` even
			// when the real database is migrated. It also means the prerendered
			// HTML would carry static fallback copy instead of the published
			// content — the opposite of what this architecture is for.
			"remote": true
		},
		{
			// Next.js tag cache — powers revalidateTag()/revalidatePath() so that
			// publishing in the admin panel refreshes only the affected pages.
			// Kept in its own database: the adapter manages these tables itself and
			// they should not sit next to application tables.
			"binding": "NEXT_TAG_CACHE_D1",
			"database_name": "infoane-next-cache",
			"database_id": "d35729ff-de68-4c86-95e9-08a7c92c3c69"
		}
	],
	"kv_namespaces": [
		{
			// Incremental cache: the rendered HTML/RSC payloads for ISR pages.
			// KV ships enabled on every account, unlike R2 — no product to enable.
			// Create with `npx wrangler kv namespace create NEXT_INC_CACHE_KV`.
			"binding": "NEXT_INC_CACHE_KV",
			"id": "e7050920e6fa4fe59ea9e54dae69e6b0",
			"remote": true
		}
	],
	// Editor uploads (logos, team photos, case study imagery) live in ImageKit
	// instead of R2 — no bucket to provision, and it comes with on-the-fly
	// image transforms/CDN delivery for free.
	//
	// IMAGEKIT_PRIVATE_KEY is a secret, not a var: set it with
	// `npx wrangler secret put IMAGEKIT_PRIVATE_KEY`, never commit it here.
	"vars": {
		"IMAGEKIT_PUBLIC_KEY": "REPLACE_WITH_IMAGEKIT_PUBLIC_KEY",
		"IMAGEKIT_URL_ENDPOINT": "REPLACE_WITH_IMAGEKIT_URL_ENDPOINT",
		// Enquiry emails (src/app/api/enquiry). Until the receiving address, the
		// sender and the Brevo key are all set, the forms fall back to opening the
		// visitor's email app.
		//   ENQUIRY_TO_EMAIL    the inbox that receives enquiries and applications
		//   ENQUIRY_FROM_NAME   display name on those emails
		// Two settings are secrets, not vars, so they stay out of git:
		//   BREVO_API_KEY       `npx wrangler secret put BREVO_API_KEY`
		//   ENQUIRY_FROM_EMAIL  the sender address verified in Brevo (SPF/DKIM set up)
		//                       `npx wrangler secret put ENQUIRY_FROM_EMAIL`
		// Do not add either of them back here: a var and a secret with the same
		// name conflict on deploy.
		"ENQUIRY_TO_EMAIL": "info@infoane.com",
		"ENQUIRY_FROM_NAME": "Infoane Website"
	},
	// Required by the incremental cache so the Worker can call back into itself
	// when regenerating a page.
	"services": [
		{
			"binding": "WORKER_SELF_REFERENCE",
			"service": "demoinfoane"
		}
	],
	// Durable Object queue for time-based revalidation.
	"durable_objects": {
		"bindings": [
			{
				"name": "NEXT_CACHE_DO_QUEUE",
				"class_name": "DOQueueHandler"
			}
		]
	},
	"migrations": [
		{
			"tag": "v1",
			"new_sqlite_classes": [
				"DOQueueHandler"
			]
		}
	]
}